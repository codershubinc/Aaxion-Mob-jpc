<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#0A0E17"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <!-- Header Row: Icon, Title, and Cancel Action Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/notification_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_upload"
            android:contentDescription="Upload Icon" />

        <TextView
            android:id="@+id/notification_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="8dp"
            android:text="Uploading file..."
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="middle" />

        <ImageView
            android:id="@+id/notification_cancel_button"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_close_vector"
            android:padding="2dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Cancel Upload" />
    </LinearLayout>

    <!-- Horizontal Progress Bar -->
    <ProgressBar
        android:id="@+id/notification_progress_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="8dp"
        android:max="100"
        android:progress="0"
        android:indeterminate="false" />

    <!-- Subtitle Row: Detail (Speed / Count) + Percentage -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/notification_info_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Preparing upload..."
            android:textColor="#8F9CAE"
            android:textSize="11sp"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/notification_percentage_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="0%"
            android:textColor="#3D7BFD"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
